<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <meta name="theme-color" content="#0a0a0a" />
  <meta name="description" content="Web Builder by Daiwik Budarkattimath & Harshit Joshi — 16-year-old full-stack developers from Dharwad, Karnataka offering mobile apps, website design, poster design, branding, e-commerce, and SEO services." />
  <title>Web Builder · Daiwik Budarkattimath &amp; Harshit Joshi</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Sora:wght@300;400;600;700;800&family=JetBrains+Mono:wght@400;500&family=Cormorant+Garamond:wght@600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    html {
      scroll-behavior: smooth;
      -webkit-text-size-adjust: 100%;
      text-size-adjust: 100%;
      overflow-x: hidden;
      overflow-y: auto;
      height: 100%;
      background: #0a0a0a;
    }

    body {
      background: #0a0a0a;
      color: #f2f2f2;
      font-family: 'Sora', sans-serif;
      font-weight: 300;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      -moz-osx-font-smoothing: grayscale;
      overflow-x: hidden;
      overflow-y: auto;
      min-height: 100vh;
      min-height: -webkit-fill-available;
      min-height: 100dvh;
      position: relative;
    }

    img { max-width: 100%; height: auto; display: block; }

    button, input, textarea, select {
      font-family: inherit;
      font-size: inherit;
      -webkit-tap-highlight-color: transparent;
    }

    button, a, [role="button"] {
      touch-action: manipulation;
      -webkit-tap-highlight-color: rgba(34, 212, 114, 0.15);
    }

    *:focus-visible {
      outline: 2px solid hsl(142 72% 50%);
      outline-offset: 3px;
      border-radius: 4px;
    }

    body.modal-open { overflow: hidden; }

    .skip-link {
      position: absolute; top: -60px; left: 16px; z-index: 9999;
      background: hsl(142 72% 50%); color: #0a0a0a;
      padding: 10px 18px; border-radius: 6px;
      font-weight: 600; font-size: 13px; text-decoration: none;
      transition: top 0.2s;
    }
    .skip-link:focus { top: 16px; }

    .sr-only {
      position: absolute; width: 1px; height: 1px;
      padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0,0,0,0); white-space: nowrap; border: 0;
    }

    :root {
      --background: 0 0% 4%;
      --surface: 0 0% 7%;
      --surface-raised: 0 0% 10%;
      --border: 0 0% 13%;
      --foreground: 0 0% 95%;
      --muted: 0 0% 42%;
      --primary: 142 72% 50%;
      --primary-dark: 142 76% 38%;
      --gold: 45 90% 55%;
      --gold-light: 45 100% 70%;
      --gold-dark: 40 85% 40%;
      --mono: 'JetBrains Mono', monospace;
      --serif: 'Cormorant Garamond', serif;
      --nav-height: 66px;
      --safe-top: env(safe-area-inset-top, 0px);
      --safe-bottom: env(safe-area-inset-bottom, 0px);
      --safe-left: env(safe-area-inset-left, 0px);
      --safe-right: env(safe-area-inset-right, 0px);
    }

    #bg-canvas {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    .content-wrapper {
      position: relative;
      z-index: 2;
      width: 100%;
    }

    .container {
      width: 100%;
      max-width: 100%;
      margin: 0 auto;
      padding-left: calc(16px + var(--safe-left));
      padding-right: calc(16px + var(--safe-right));
    }
    @media (min-width: 480px) {
      .container { padding-left: calc(24px + var(--safe-left)); padding-right: calc(24px + var(--safe-right)); }
    }
    @media (min-width: 640px) { .container { max-width: 640px; } }
    @media (min-width: 768px) {
      .container { max-width: 768px; padding-left: calc(32px + var(--safe-left)); padding-right: calc(32px + var(--safe-right)); }
    }
    @media (min-width: 1024px) {
      .container { max-width: 1024px; padding-left: calc(48px + var(--safe-left)); padding-right: calc(48px + var(--safe-right)); }
    }
    @media (min-width: 1280px) { .container { max-width: 1280px; padding-left: calc(64px + var(--safe-left)); padding-right: calc(64px + var(--safe-right)); } }
    @media (min-width: 1440px) { .container { max-width: 1360px; } }
    @media (min-width: 1920px) { .container { max-width: 1440px; } }
    @media (min-width: 2560px) { .container { max-width: 1600px; } }

    .logo-mark {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      position: relative;
      flex-shrink: 0;
    }
    .logo-mark svg {
      display: block;
      width: 44px;
      height: 44px;
      transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1), filter 0.4s ease;
      filter: drop-shadow(0 2px 8px hsl(45 90% 55% / 0.35));
    }
    .logo-mark:hover svg {
      transform: rotate(-8deg) scale(1.06);
      filter: drop-shadow(0 4px 16px hsl(45 90% 55% / 0.6));
    }
    @media (min-width: 480px) {
      .logo-mark svg { width: 48px; height: 48px; }
    }
    .logo-wordmark {
      display: flex;
      flex-direction: column;
      line-height: 1;
      gap: 2px;
      min-width: 0;
    }
    .logo-wordmark .logo-text {
      font-family: var(--serif);
      font-weight: 700;
      font-size: 20px;
      letter-spacing: -0.005em;
      background: linear-gradient(135deg, hsl(var(--gold-light)) 0%, hsl(var(--gold)) 35%, hsl(var(--primary)) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: hsl(var(--gold));
      white-space: nowrap;
    }
    .logo-wordmark .logo-sub {
      font-family: var(--mono);
      font-size: 8px;
      font-weight: 500;
      color: hsl(var(--muted));
      letter-spacing: 0.18em;
      text-transform: uppercase;
      white-space: nowrap;
    }
    @media (min-width: 480px) {
      .logo-wordmark .logo-text { font-size: 22px; }
      .logo-wordmark .logo-sub { font-size: 9px; }
    }

    @keyframes blink { 50% { opacity: 0; } }
    .blink { animation: blink 1s step-end infinite; }

    @keyframes float {
      0% { transform: translateY(0px); }
      50% { transform: translateY(-8px); }
      100% { transform: translateY(0px); }
    }
    .float { animation: float 4s ease-in-out infinite; }

    @keyframes pulseGreen {
      0%, 100% { box-shadow: 0 0 0 0 hsl(142 72% 50% / 0.6); }
      50% { box-shadow: 0 0 0 12px hsl(142 72% 50% / 0); }
    }
    .pulse-green { animation: pulseGreen 2s ease-in-out infinite; }

    @keyframes imageFloat {
      0%, 100% { transform: translate3d(0, 0, 0) rotateX(0deg) rotateY(0deg); }
      25% { transform: translate3d(0, -6px, 0) rotateX(1deg) rotateY(-1deg); }
      50% { transform: translate3d(0, -10px, 0) rotateX(0deg) rotateY(0deg); }
      75% { transform: translate3d(0, -6px, 0) rotateX(-1deg) rotateY(1deg); }
    }

    @keyframes galleryFloat {
      0%, 100% { transform: translate3d(0, 0, 0) rotateZ(0deg); }
      33% { transform: translate3d(0, -6px, 0) rotateZ(0.4deg); }
      66% { transform: translate3d(0, -3px, 0) rotateZ(-0.4deg); }
    }

    @keyframes serviceFloat {
      0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
      50% { transform: translate3d(0, -4px, 0) scale(1.02); }
    }

    @keyframes shineSweep {
      0% { transform: translateX(-100%) rotate(15deg); opacity: 0; }
      50% { opacity: 0.6; }
      100% { transform: translateX(200%) rotate(15deg); opacity: 0; }
    }

    @keyframes avatarRotateIn {
      0% { opacity: 0; transform: rotateY(-180deg) scale(0.6); }
      60% { opacity: 1; transform: rotateY(20deg) scale(1.05); }
      100% { opacity: 1; transform: rotateY(0deg) scale(1); }
    }
    @keyframes avatarFloat {
      0%, 100% { transform: translateY(0) rotateZ(0deg); }
      50% { transform: translateY(-5px) rotateZ(2deg); }
    }
    @keyframes avatarRingSpin {
      0% { transform: rotate(0deg); }
      100% { transform: rotate(360deg); }
    }
    @keyframes avatarRingPulse {
      0%, 100% { opacity: 0.4; transform: scale(1); }
      50% { opacity: 0.8; transform: scale(1.06); }
    }
    @keyframes pulseDot {
      0%, 100% { box-shadow: 0 0 12px hsl(142 72% 50% / 0.6); }
      50% { box-shadow: 0 0 22px hsl(142 72% 50% / 1); }
    }

    @keyframes modalBackdropIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
    @keyframes modalCardIn {
      from { opacity: 0; transform: translateY(20px) scale(0.95); }
      to { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes modalIconPop {
      0% { transform: scale(0.5); opacity: 0; }
      50% { transform: scale(1.1); }
      100% { transform: scale(1); opacity: 1; }
    }

    .fade-up {
      opacity: 0; transform: translateY(20px);
      transition: opacity 0.6s ease, transform 0.6s ease;
    }
    .fade-up.visible { opacity: 1; transform: translateY(0); }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
        scroll-behavior: auto !important;
      }
      .fade-up { opacity: 1; transform: none; }
      .personal-avatar, .avatar-ring { animation: none !important; }
    }

    .navbar {
      position: fixed; top: 0; left: 0; width: 100%; z-index: 1000;
      background: hsl(var(--background) / 0.92);
      backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid hsl(var(--border));
      padding: 10px 0;
      padding-top: calc(10px + var(--safe-top));
    }
    .navbar-inner {
      display: flex; align-items: center; justify-content: space-between;
      gap: 8px;
    }
    .nav-brand {
      display: flex; align-items: center; gap: 10px;
      flex-shrink: 1; min-width: 0;
      text-decoration: none;
      transition: transform 0.3s ease;
    }
    .nav-brand:hover { transform: translateY(-1px); }

    @media (max-width: 479px) {
      .nav-brand .logo-wordmark { display: none; }
    }

    .nav-center {
      display: none;
      gap: 24px; align-items: center;
      flex: 1; justify-content: center;
    }
    .nav-center a {
      color: hsl(var(--muted)); text-decoration: none; font-size: 13px;
      font-weight: 500; transition: color 0.18s;
      padding: 8px 4px; border-radius: 4px;
      white-space: nowrap;
    }
    .nav-center a:hover { color: hsl(var(--gold)); }
    @media (min-width: 1100px) {
      .nav-center { display: flex; }
    }

    .nav-actions {
      display: flex; align-items: center; gap: 8px;
      flex-shrink: 0;
    }
    .nav-actions .btn-primary { display: none; }
    @media (min-width: 640px) {
      .nav-actions .btn-primary { display: inline-flex; }
    }

    .btn-primary {
      background: hsl(var(--primary)); color: #0a0a0a; border: none;
      padding: 10px 18px; border-radius: 6px;
      font-family: 'Sora', sans-serif; font-weight: 600;
      font-size: 13px; cursor: pointer;
      transition: background 0.18s, box-shadow 0.18s; text-decoration: none;
      display: inline-flex; align-items: center; justify-content: center; gap: 6px;
      border: 1px solid transparent;
      min-height: 44px;
      line-height: 1;
      white-space: nowrap;
    }
    .btn-primary:hover {
      background: hsl(var(--primary-dark));
      box-shadow: 0 0 24px hsl(142 72% 50% / 0.2);
    }
    .btn-primary:active { transform: scale(0.98); }

    .btn-ghost {
      background: transparent; color: hsl(var(--foreground));
      border: 1px solid hsl(var(--border)); padding: 10px 18px;
      border-radius: 6px; font-family: 'Sora', sans-serif; font-weight: 500;
      font-size: 13px; cursor: pointer;
      transition: border-color 0.18s, box-shadow 0.18s, color 0.18s;
      text-decoration: none; display: inline-flex;
      align-items: center; justify-content: center; gap: 6px;
      min-height: 44px;
      line-height: 1;
      white-space: nowrap;
    }
    .btn-ghost:hover {
      border-color: hsl(var(--primary));
      color: hsl(var(--primary));
      box-shadow: 0 0 24px hsl(142 72% 50% / 0.08);
    }
    .btn-ghost:active { transform: scale(0.98); }

    .three-dot-wrapper { position: relative; display: inline-flex; }

    .three-dot-btn {
      background: transparent;
      border: 1px solid hsl(var(--border));
      color: hsl(var(--foreground));
      width: 44px; height: 44px;
      border-radius: 6px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      font-size: 18px;
      transition: border-color 0.18s, color 0.18s, background 0.18s, box-shadow 0.18s;
      flex-shrink: 0;
    }
    .three-dot-btn:hover,
    .three-dot-btn:focus-visible {
      border-color: hsl(var(--primary));
      color: hsl(var(--primary));
      background: hsl(var(--primary) / 0.06);
      box-shadow: 0 0 20px hsl(142 72% 50% / 0.15);
    }
    .three-dot-btn[aria-expanded="true"] {
      border-color: hsl(var(--primary));
      color: hsl(var(--primary));
      background: hsl(var(--primary) / 0.1);
    }

    .category-menu {
      position: fixed;
      top: calc(var(--nav-height) + var(--safe-top));
      left: calc(12px + var(--safe-left));
      right: calc(12px + var(--safe-right));
      width: auto;
      max-width: 380px;
      margin-left: auto;
      margin-right: auto;
      max-height: 0;
      overflow: hidden;
      background: hsl(var(--background) / 0.98);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid hsl(var(--border));
      border-radius: 12px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.6), 0 0 40px hsl(142 72% 50% / 0.08);
      opacity: 0;
      transform: translateY(-8px);
      transition: max-height 0.35s ease, opacity 0.25s ease, transform 0.25s ease, padding 0.25s ease;
      padding: 0;
      pointer-events: none;
      z-index: 1100;
    }
    @media (min-width: 768px) {
      .category-menu {
        position: absolute;
        top: calc(100% + 10px);
        right: 0;
        left: auto;
        width: 380px;
        max-width: calc(100vw - 48px);
        margin: 0;
      }
    }
    .category-menu.open {
      max-height: min(720px, calc(100vh - var(--nav-height) - 40px));
      opacity: 1;
      transform: translateY(0);
      padding: 14px;
      pointer-events: auto;
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }

    .category-menu-header {
      font-family: var(--mono);
      font-size: 9px;
      color: hsl(var(--muted));
      text-transform: uppercase;
      letter-spacing: 0.12em;
      padding: 6px 12px 10px;
      border-bottom: 1px solid hsl(var(--border));
      margin-bottom: 8px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .category-menu-header i { color: hsl(var(--primary)); font-size: 10px; }

    .category-group { margin-bottom: 10px; }
    .category-group:last-child { margin-bottom: 0; }

    .category-group-label {
      font-family: var(--mono);
      font-size: 9px;
      color: hsl(var(--primary));
      text-transform: uppercase;
      letter-spacing: 0.1em;
      padding: 6px 12px 4px;
      opacity: 0.85;
    }

    .category-link {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border-radius: 8px;
      text-decoration: none;
      color: hsl(var(--foreground));
      font-size: 13px;
      font-weight: 500;
      transition: background 0.15s, color 0.15s, padding-left 0.15s;
      border: none;
      background: transparent;
      width: 100%;
      text-align: left;
      cursor: pointer;
      font-family: 'Sora', sans-serif;
      min-height: 44px;
    }
    .category-link:hover,
    .category-link:focus-visible {
      background: hsl(var(--primary) / 0.08);
      color: hsl(var(--primary));
      padding-left: 16px;
    }
    .category-link:active { background: hsl(var(--primary) / 0.14); }
    .category-link i {
      width: 18px;
      text-align: center;
      color: hsl(var(--primary));
      font-size: 12px;
      flex-shrink: 0;
    }
    .category-link .link-label { flex: 1; min-width: 0; }
    .category-link .link-badge {
      font-family: var(--mono);
      font-size: 9px;
      color: hsl(var(--muted));
      letter-spacing: 0.04em;
      white-space: nowrap;
    }
    .category-link:hover .link-badge,
    .category-link:focus-visible .link-badge { color: hsl(var(--primary)); }

    .category-divider {
      height: 1px;
      background: hsl(var(--border));
      margin: 8px 0;
    }

    .hamburger {
      display: inline-flex;
      background: none; border: 1px solid hsl(var(--border));
      color: hsl(var(--foreground)); font-size: 20px; cursor: pointer;
      width: 44px; height: 44px; border-radius: 6px;
      align-items: center; justify-content: center;
      transition: border-color 0.18s, color 0.18s;
      flex-shrink: 0;
    }
    .hamburger:hover, .hamburger:active {
      border-color: hsl(var(--primary));
      color: hsl(var(--primary));
    }
    @media (min-width: 1100px) {
      .hamburger { display: none; }
    }

    .mobile-menu {
      position: fixed;
      top: calc(var(--nav-height) + var(--safe-top));
      left: 0;
      width: 100%;
      max-height: 0;
      overflow: hidden;
      background: hsl(var(--background) / 0.98);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border-bottom: 1px solid hsl(var(--border));
      transition: max-height 0.4s ease;
      z-index: 999;
    }
    .mobile-menu.open {
      max-height: calc(100vh - var(--nav-height));
      overflow-y: auto;
      -webkit-overflow-scrolling: touch;
    }
    @media (min-width: 1100px) {
      .mobile-menu { display: none; }
    }
    .mobile-menu-inner {
      padding: 20px calc(20px + var(--safe-left)) calc(28px + var(--safe-bottom)) calc(20px + var(--safe-right));
    }
    .mobile-menu-group { margin-bottom: 20px; }
    .mobile-menu-group:last-child { margin-bottom: 0; }
    .mobile-menu-group-label {
      font-family: var(--mono);
      font-size: 9px;
      color: hsl(var(--primary));
      text-transform: uppercase;
      letter-spacing: 0.1em;
      margin-bottom: 8px;
      padding-left: 4px;
    }
    .mobile-menu a {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 8px;
      color: hsl(var(--foreground));
      text-decoration: none;
      font-size: 15px;
      font-weight: 500;
      border-bottom: 1px solid hsl(var(--border));
      transition: color 0.18s, padding-left 0.18s;
      min-height: 48px;
    }
    .mobile-menu a:hover, .mobile-menu a:focus-visible, .mobile-menu a:active {
      color: hsl(var(--primary));
      padding-left: 14px;
    }
    .mobile-menu a:last-child { border-bottom: none; }
    .mobile-menu a i {
      color: hsl(var(--primary));
      font-size: 14px;
      width: 20px;
      text-align: center;
      flex-shrink: 0;
    }
    .mobile-menu .btn-primary {
      border-bottom: none;
      justify-content: center;
      margin-top: 12px;
      color: #0a0a0a;
    }

    .hero {
      min-height: 100vh;
      min-height: 100dvh;
      display: flex; align-items: center;
      padding: 100px 0 60px;
      padding-top: calc(90px + var(--safe-top));
      padding-bottom: calc(60px + var(--safe-bottom));
      margin-top: var(--nav-height);
    }
    @media (min-width: 768px) { .hero { padding: 120px 0 80px; } }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 40px;
      align-items: center;
      width: 100%;
    }
    @media (min-width: 900px) {
      .hero-grid { grid-template-columns: 1fr 1fr; gap: 60px; }
    }

    .hero-badge {
      display: inline-flex; align-items: center; gap: 6px;
      font-family: var(--mono); font-size: 10px; font-weight: 500;
      color: hsl(var(--primary)); background: hsl(var(--primary) / 0.08);
      border: 1px solid hsl(var(--primary) / 0.2);
      padding: 6px 12px; border-radius: 100px; margin-bottom: 20px;
      letter-spacing: 0.02em; text-transform: uppercase;
      flex-wrap: wrap;
    }
    @media (min-width: 480px) {
      .hero-badge { font-size: 11px; padding: 6px 14px; }
    }

    .hero h1 {
      font-family: 'Sora', sans-serif; font-weight: 800;
      font-size: clamp(32px, 9vw, 88px);
      line-height: 1.02;
      letter-spacing: -0.04em; color: #fff; margin-bottom: 20px;
      word-wrap: break-word;
      overflow-wrap: break-word;
    }
    @media (min-width: 900px) {
      .hero h1 { line-height: 0.95; margin-bottom: 24px; }
    }
    .hero h1 .highlight {
      background: linear-gradient(135deg, hsl(var(--gold-light)) 0%, hsl(var(--primary)) 100%);
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
      color: hsl(var(--primary));
    }

    .hero-sub {
      font-family: 'Sora', sans-serif; font-weight: 300;
      font-size: 15px;
